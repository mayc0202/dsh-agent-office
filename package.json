{
  "name": "dsh-night-shift",
  "version": "0.4.0",
  "description": "Night Shift：把 DeepSeek Harness 会话变成实时 3D 办公室（复刻原版 Night Shift 视觉，本地插件，无外部服务）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/state.js",
    "lib/client.js",
    "lib/panel.html",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "screenshot.png",
    "screenshot-focus.png",
    "screenshot-client.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "night-shift",
    "3d",
    "visualization",
    "cordis"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayc0202/dsh-night-shift.git"
  },
  "homepage": "https://github.com/mayc0202/dsh-night-shift#readme",
  "bugs": {
    "url": "https://github.com/mayc0202/dsh-night-shift/issues"
  },
  "scripts": {
    "dev": "node dev/dev-server.mjs",
    "check": "node --check lib/index.js && node --check lib/state.js && node --check lib/client.js"
  }
}
