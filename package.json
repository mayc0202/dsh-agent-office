{
  "name": "dsh-agent-office",
  "version": "4.2.1",
  "description": "实时 3D 办公室可视化 DSH 会话；Catora 发布后拓展笔记、思维导图、私人知识库与 RAG 检索。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/state.js",
    "lib/client.js",
    "lib/panel.html",
    "cordis.patch.yml",
    "icon.svg",
    "icon.png",
    "panel-src",
    "panel/build.mjs",
    "NOTICE",
    "README.md",
    "screenshot.png",
    "screenshot-day.png",
    "screenshot-focus.png",
    "screenshot-client.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "agent-office",
    "3d",
    "office",
    "deepseek-harness",
    "catora",
    "mcp",
    "rag",
    "notes",
    "mindmap"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayc0202/dsh-agent-office.git"
  },
  "homepage": "https://github.com/mayc0202/dsh-agent-office#readme",
  "bugs": {
    "url": "https://github.com/mayc0202/dsh-agent-office/issues"
  },
  "scripts": {
    "dev": "node dev/dev-server.mjs",
    "build": "node panel/build.mjs",
    "check": "node --check lib/index.js && node --check lib/state.js && node --check lib/client.js",
    "prepublishOnly": "npm run check && node -e \"const fs=require('fs');if(!fs.existsSync('lib/panel.html')){console.error('lib/panel.html 缺失，请先 npm install && npm run build');process.exit(1)}\"",
    "release": "npm run build && npm publish"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "three": "^0.171.0"
  },
  "author": "mayc0202",
  "icon": "icon.png"
}
