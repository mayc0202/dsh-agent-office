{
  "name": "dsh-agent-office",
  "version": "4.1.4",
  "description": "智能体办公室：把 DeepSeek Harness 会话变成实时 3D 办公室（本地插件版，无外部服务）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/state.js",
    "lib/client.js",
    "lib/panel.html",
    "cordis.patch.yml",
    "icon.svg",
    "icon.png",
    "panel-src",
    "panel/build.mjs",
    "README.md",
    "screenshot.png",
    "screenshot-focus.png",
    "screenshot-client.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "agent-office",
    "3d",
    "office",
    "deepseek-harness",
    "catora"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayc0202/dsh-agent-office.git"
  },
  "homepage": "https://github.com/mayc0202/dsh-agent-office#readme",
  "bugs": {
    "url": "https://github.com/mayc0202/dsh-agent-office/issues"
  },
  "scripts": {
    "dev": "node dev/dev-server.mjs",
    "build": "node panel/build.mjs",
    "check": "node --check lib/index.js && node --check lib/state.js && node --check lib/client.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "three": "^0.171.0"
  },
  "author": "mayc0202",
  "icon": "icon.png"
}
